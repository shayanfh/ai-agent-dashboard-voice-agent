APP_NAME=ai-agent-dashboard-voice-agent
APP_ENV=development
LOG_LEVEL=INFO
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=ai-agent-dashboard-inbound
# Public/private HTTPS address of the Dashboard Backend server
DASHBOARD_BACKEND_URL=https://dashboard-api.example.com
DASHBOARD_INTERNAL_API_KEY=
DEFAULT_STT_PROVIDER=openai
DEFAULT_STT_MODEL=gpt-4o-mini-transcribe
DEFAULT_LLM_PROVIDER=openai
DEFAULT_LLM_MODEL=gpt-4.1-mini
DEFAULT_TTS_PROVIDER=openai
DEFAULT_TTS_MODEL=gpt-4o-mini-tts
DEFAULT_TTS_VOICE=alloy
OPENAI_API_KEY=
# Fixed model used for post-call summary, outcome and extracted data
SUMMARY_LLM_MODEL=gpt-5.6-luna
SUMMARY_LLM_TIMEOUT_SECONDS=20
SUMMARY_MAX_TRANSCRIPT_CHARS=30000
SUMMARY_MAX_OUTPUT_TOKENS=400
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
HTTP_TIMEOUT_SECONDS=10
HTTP_MAX_RETRIES=3
CALL_MAX_DURATION_SECONDS=1800
CALLER_WAIT_TIMEOUT_SECONDS=30
ENABLE_CALL_RECORDING=false
# disabled | asterisk | livekit_egress
RECORDING_PROVIDER=disabled
# Public HTTPS S3-compatible endpoint reachable by LiveKit Egress.
# For this stack use the dashboard Nginx domain; create dedicated restricted credentials.
RECORDING_S3_ENDPOINT=https://dashboard-api.example.com
RECORDING_S3_ACCESS_KEY=
RECORDING_S3_SECRET_KEY=
RECORDING_S3_BUCKET=ai-agent-dashboard
RECORDING_S3_REGION=us-east-1
ASTERISK_LINKED_ID_WAIT_SECONDS=2
ENABLE_USAGE_REPORTING=true
ENABLE_DEBUG_LOGGING=false
